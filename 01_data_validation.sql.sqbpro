lumn index="1913" value="50"/><column index="1914" value="50"/><column index="1915" value="50"/><column index="1916" value="50"/><column index="1917" value="50"/><column index="1918" value="50"/><column index="1919" value="50"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sell_prices" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="109"/><column index="3" value="70"/><column index="4" value="62"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">
-- Walmart Supply Chain Analytics
-- Data validation: sales table

SELECT
    COUNT(*) AS sales_records,
    COUNT(DISTINCT id) AS unique_sales_ids,
    COUNT(DISTINCT item_id) AS distinct_items,
    COUNT(DISTINCT store_id) AS distinct_stores,
    COUNT(DISTINCT state_id) AS distinct_states
FROM sales;

-- Data validation: calendar table

SELECT
    COUNT(*) AS calendar_rows,
    COUNT(DISTINCT d) AS unique_day_ids,
    MIN(date) AS first_date,
    MAX(date) AS last_date
FROM calendar;

-- Data validation: selling prices

SELECT
    COUNT(*) AS price_records,
    COUNT(DISTINCT store_id) AS distinct_stores,
    COUNT(DISTINCT item_id) AS distinct_items,
    MIN(sell_price) AS minimum_price,
    MAX(sell_price) AS maximum_price
FROM sell_prices;
</sql><current_tab id="0"/></tab_sql></sqlb_project>
